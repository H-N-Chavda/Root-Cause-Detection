# Filled in by whoever runs the pipeline (TA, lab computer). Every path and folder name lives here, nowhere else.
# DATA_ROOT: absolute path of the folder that contains APS_NVPS_LEU/, flare_data/, All_unit_tags/, ...
#            (same key as pca_pc_t2/.env). A relative path is read relative to this causal_t2/ folder.
#            Write it without quotes or in single quotes (double quotes treat backslashes as escapes).
# The raw data is only read, never modified.
DATA_ROOT=/home/brijesh/Desktop/HPCL_flare_project/Implementation/HPCA_SFA_new_10102026
UNIT_FOLDERS=APS_NVPS_LEU,DAK,DIU,ISOM,ISOM_3,ISOM_4,LOUP,NSU_NHT_CCR,PDA,PG,SEU1,SEU2,SEU3
FLARE_FOLDER=flare_data
ALL_TAGS_FOLDER=All_unit_tags
CONTROL_FOLDER=unit_wise_control_data
# Output folder, relative to this causal_t2/ folder.
OUT_DIR=outputs
# Time window (YYYY-MM-DD or YYYY-MM-DD HH:MM). Only rows with WINDOW_START <= time < WINDOW_END are read.
# Default: one month (May 2025, the first full month of the data). Leave both empty to run on all data.
# Changing the window needs  python causal_t2/run_all.py --force  (or a different OUT_DIR).
WINDOW_START=2025-05-01
WINDOW_END=2025-06-01
