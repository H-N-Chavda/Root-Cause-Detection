# Filled in by whoever runs the pipeline (TA, lab computer).
# Absolute path of the folder that contains All_unit_tags/, flare_data/, APS_NVPS_LEU/, DAK/, ...
# The raw data is only read, never modified.
DATA_ROOT=
# Time window (YYYY-MM-DD or YYYY-MM-DD HH:MM). Only rows with WINDOW_START <= time < WINDOW_END are read.
# Default: one month (May 2025, the first full month of the data). Leave both empty to run on all data.
WINDOW_START=2025-05-01
WINDOW_END=2025-06-01
