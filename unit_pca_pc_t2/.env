# Filled in by whoever runs the pipeline (TA, lab computer). Paths and data names only; parameters are in config.py.
# DATA_ROOT: absolute path of the folder that contains APS_NVPS_LEU/, flare_data/, ... (relative = from unit_pca_pc_t2/).
#            Write it without quotes or in single quotes (double quotes treat backslashes as escapes).
DATA_ROOT=D:\Dataset_HPCL
UNIT_FOLDERS=APS_NVPS_LEU,DAK,DIU,ISOM,ISOM_3,ISOM_4,LOUP,NSU_NHT_CCR,PDA,PG,SEU1,SEU2,SEU3
FLARE_FOLDER=flare_data
ALL_TAGS_FOLDER=All_unit_tags
CONTROL_FOLDER=unit_wise_control_data
# Output folder, relative to unit_pca_pc_t2/.
OUT_DIR=outputs
# Exact column names in flare_data/ for flare_net = FLARE_1_TAG + FLARE_2_TAG - FLARE_RECOVERY_TAG
# (mapping read from the tag names, UNVERIFIED against plant documentation).
FLARE_1_TAG='(LRflare.pv+LREflare.pv+99fi4601.daca.pv)/1000'
FLARE_2_TAG='509fi5201.daca.pv/1000'
FLARE_RECOVERY_TAG='(44ft2505.pv*509mw5101.daca.pv/22.414)/1000'
